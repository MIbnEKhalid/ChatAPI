{
    "version": 2,
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "builds": [
      {
        "src": "index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/index.js"
      },
      {
        "src": "/mbkauthe/(.*)",
        "dest": "/index.js"
      },
      {
        "src": "/login",
        "dest": "/index.js"
      },
      {
        "src": "/Assets/(.*)",
        "dest": "/index.js"
      },
      {
        "src": "/icon.svg",
        "dest": "/index.js"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ]
  }
